declare(strict_types=1);

namespace App\Schema;

use App\Model\{{model}};
use Laika\Model\Schema\Schema;
use Laika\Model\Schema\Blueprint;
use Laika\Core\Abstracts\SchemaAbstract;
use Laika\Core\Exceptions\SchemaException;

class {{class}} extends SchemaAbstract
{
    protected string $table = '{{table}}';

    public function up(): void
    {
        Schema::on()->createIfNotExists($this->table, function (Blueprint $t) {
            $t->id('{{id}}');
            $t->string('{{uid}}');
            $t->timestamps();
            $t->enum('deleted', ['yes', 'no'])->default('no');
            $t->timestamp('deleted_at')->nullable();

            $t->index('deleted');
        });
    }

    public function seed(): void
    {
        try {
            $model = new {{model}}();
            $arr = [
                '{{uid}}'       =>  $model->uid(),
                'deleted'   =>  'yes'
            ];

            $model->transaction(function ({{model}} $m) use ($arr) {
                $m->insert($arr);
            });
        } catch (\Throwable $e) {
            if (DEBUG) throw new SchemaException("Failed to seed data. {$e->getMessage()}", (int) $e->getCode(), $e);
        }
    }
}
