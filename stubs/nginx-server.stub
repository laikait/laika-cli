# Laika server block. Drop this in /etc/nginx/sites-available/ and symlink
# it into sites-enabled/, or paste it into your existing nginx config.
#
#   nginx -t && systemctl reload nginx

server {
    listen {{port}};
    listen [::]:{{port}};

    server_name {{domain}};
    root {{root}};

    index index.php;
    charset utf-8;

    client_max_body_size {{upload}};

    # Framework-managed rules (deny lists, front-controller rewrite).
    # Regenerate with `php laika nginx:make`. Keep this include above the
    # handler below: the deny rules are regex locations and nginx uses the
    # first matching one, so they must be seen first.
    include {{root}}/nginx.conf;

    # The only PHP that is ever executed. An exact-match location cannot be
    # reached by /uploads/evil.php or /template/loader.php, so no file other
    # than the front controller can be run even if one is written into a
    # served directory. It also terminates the rewrite in nginx.conf --
    # without this block that rewrite loops.
    location = /index.php {
        fastcgi_pass {{fastcgi}};
        fastcgi_index index.php;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;

        # Laika reads the Authorization header for token guards
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }

    access_log {{root}}/lf-logs/nginx-access.log;
    error_log  {{root}}/lf-logs/nginx-error.log;
}
